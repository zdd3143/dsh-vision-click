{
  "name": "dsh-vision-click",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "按界面文字操作 Windows：OCR 定位 + 鼠标（点击/双击/长按/悬停/拖动/滚轮）+ 键盘（键入/组合键），每个动作自动复核像素与文字变化，F6+F7 急停。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zdd3143/dsh-vision-click.git"
  },
  "homepage": "https://github.com/zdd3143/dsh-vision-click#readme",
  "bugs": {
    "url": "https://github.com/zdd3143/dsh-vision-click/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "gui-agent",
    "computer-use",
    "ocr",
    "windows",
    "automation",
    "ui-tars"
  ],
  "meta": {
    "title": "视觉点击（OCR 定位 / 鼠标 + 键盘）",
    "description": "按界面上的文字操作 Windows：截图后由系统 OCR 定位，可左/右/中键点击、双击、长按、悬停、拖动、滚轮、键入文字与组合键；每个动作后自动比对像素与文字，报告是否真的生效。F6+F7 随时急停。"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts/agent.ps1",
    "scripts/stop-watcher.ps1",
    "scripts/build-ocr.ps1",
    "native/DshOcr.cs",
    "native/DshOcr.dll",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "scripts": {
    "build:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ocr.ps1",
    "test": "node tests/run-click-test.mjs",
    "test:window": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/target-window.ps1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
